{
  "name": "tenet",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": ["bb-plugin-tenet-status"],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "delivery:check": "bun --no-env-file scripts/check-delivery-consumers.ts",
    "test": "bun test --isolate --max-concurrency=1 --timeout=30000",
    "lint": "oxlint --deny-warnings .",
    "validate:offline": "env -u BASH_ENV -u ENV /bin/bash --noprofile --norc scripts/validate-offline.sh",
    "sdk:build": "bun --bun tsc -p tsconfig.sdk.json && bun --bun tsc -p tsconfig.sdk-example.json",
    "sdk:example": "bun run sdk:build && node examples/dist/sdk.js",
    "mcp:check": "env -u BASH_ENV -u ENV /bin/bash --noprofile --norc scripts/check-mcp-hooks.sh",
    "smoke": "bun run sdk:build && bun test ./test/pi-smoke.test.ts",
    "typecheck": "bun run sdk:build && bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.sdk-example.json --noEmit",
    "claude:bridge": "bun src/claude/cli.ts bridge",
    "claude:hook": "bun src/claude/cli.ts hook",
    "inspector:build": "vite build inspector",
    "summary:build": "vite build --config inspector/vite.summary.config.ts && tsc -p inspector/tsconfig.summary.json && bun scripts/build-summary-types.ts",
    "summary:preview": "vite inspector --host 127.0.0.1",
    "plugin:build": "bun run summary:build && bun run --cwd bb-plugin-tenet-status build",
    "inspector:check": "tsc -p inspector/tsconfig.json",
    "inspector": "bun src/inspector/cli.ts",
    "inspector:serve": "bun src/inspector/serve-cli.ts",
    "inspector:test": "bun run inspector:test:discovery && bun run inspector:test:node && bun run inspector:test:components && bun run inspector:test:journeys",
    "inspector:test:components": "vitest run --config inspector/vitest.browser.config.ts",
    "inspector:test:node": "bun run inspector:build && vitest run --config inspector/vitest.node.config.ts",
    "inspector:test:journeys": "bun run inspector:build && playwright test --config inspector/playwright.config.ts",
    "inspector:test:discovery": "node scripts/check-inspector-discovery.mjs",
    "site:build": "bun site/build.ts",
    "site:check": "tsc -p site/tsconfig.json",
    "site:test": "bun run site:build && bun run test ./test/marketing-site.test.mjs && vitest run --config site/vitest.config.ts",
    "pi": "bun run sdk:build && bun ./node_modules/@earendil-works/pi-coding-agent/dist/cli.js -e ./src/pi/extension.ts"
  },
  "pi": {
    "extensions": ["./src/pi/extension.ts"]
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "5.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "marked": "18.0.13",
    "oxlint": "1.88.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "vitest-browser-react": "2.3.0"
  }
}
