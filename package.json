{
  "name": "tenet-publication-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test",
    "smoke": "bun test ./test/pi-smoke.test.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "claude:bridge": "bun src/claude/cli.ts bridge",
    "claude:hook": "bun src/claude/cli.ts hook",
    "inspector:build": "vite build inspector",
    "inspector:check": "svelte-check --workspace inspector --tsconfig ./tsconfig.json",
    "inspector": "bun src/inspector/cli.ts",
    "inspector:serve": "bun src/inspector/serve-cli.ts",
    "inspector:test": "bun run inspector:test:components && bun run inspector:test:browser",
    "inspector:test:components": "vitest run --config inspector/vitest.browser.config.ts",
    "inspector:test:browser": "bun run inspector:build && vitest run --config inspector/vitest.config.ts",
    "pi": "bun ./node_modules/@earendil-works/pi-coding-agent/dist/cli.js -e ./src/pi/extension.ts"
  },
  "pi": {
    "extensions": ["./src/pi/extension.ts"]
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.19.15",
    "@vitest/browser-playwright": "5.0.1",
    "marked": "18.0.13",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "vitest-browser-svelte": "3.1.0"
  }
}
