{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["server.ts", "host.ts", "contract.ts", "app.tsx", "*.test.ts", "*.vitest.tsx", "../src/inspector/**/*.ts", "../src/recording/**/*.ts"]
}
